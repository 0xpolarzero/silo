@@ -0,0 +1,47 @@
+//go:build linux
+
+package sandbox
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+// consumeD2RootfsSyncEIO arms a single synchronous, destroy-path rootfs diff
+// sync failure for one sandbox. The diagnostic orchestrator must receive a
+// private, owned 0700 directory in SILO_D2_ROOTFS_SYNC_EIO_DIR. An owned 0600
+// file named <sandbox-id>.trigger must contain exactly "<sandbox-id>\n".
+// Renaming it to .fired records which request consumed the one-shot fault.
+func consumeD2RootfsSyncEIO(sandboxID string) bool {
+	dir := os.Getenv("SILO_D2_ROOTFS_SYNC_EIO_DIR")
+	if dir == "" || sandboxID == "" || filepath.Base(sandboxID) != sandboxID {
+		return false
+	}
+	if !d2OwnedRegular(dir, os.ModeDir, 0o700) {
+		return false
+	}
+
+	trigger := filepath.Join(dir, sandboxID+".trigger")
+	if !d2OwnedRegular(trigger, 0, 0o600) {
+		return false
+	}
+	contents, err := os.ReadFile(trigger)
+	if err != nil || string(contents) != sandboxID+"\n" {
+		return false
+	}
+	fired := trigger + ".fired"
+	if _, err := os.Lstat(fired); !os.IsNotExist(err) {
+		return false
+	}
+	return os.Rename(trigger, fired) == nil
+}
+
+func d2OwnedRegular(path string, wantedType os.FileMode, wantedPerm os.FileMode) bool {
+	info, err := os.Lstat(path)
+	if err != nil || info.Mode()&os.ModeType != wantedType || info.Mode().Perm() != wantedPerm {
+		return false
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	return ok && stat.Uid == uint32(os.Geteuid())
+}
