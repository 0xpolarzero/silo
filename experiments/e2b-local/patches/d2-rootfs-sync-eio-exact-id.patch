+	require.NoError(t, err)
+	_, err = f.File.WriteAt([]byte("d2 dirty rootfs block"), 0)
+	require.NoError(t, err)
+	path := f.cachePath
+
+	diff, err := f.CloseToDiffWithSyncEIO(blockSize)
+	require.Nil(t, diff)
+	require.ErrorContains(t, err, "failed to sync file: sync "+path+": input/output error")
+	require.True(t, errors.Is(err, syscall.EIO))
+	_, statErr := os.Stat(path)
+	require.True(t, os.IsNotExist(statErr), "failed diff remained on disk: %v", statErr)
+}
