{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../../app/SiloUI/src/*"
      ],
      "react": [
        "../../app/SiloUI/node_modules/@types/react"
      ],
      "react/*": [
        "../../app/SiloUI/node_modules/@types/react/*"
      ],
      "lucide-react": [
        "../../app/SiloUI/node_modules/lucide-react"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "Film.tsx"
  ]
}
