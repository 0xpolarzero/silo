#!/bin/sh
set -eu
. /usr/share/debconf/confmodule
if [ "$1" = configure ]; then
    db_get silo/system-updates
    source=/etc/apt/sources.list.d/silo.sources
    template=/usr/share/silo/apt/silo.sources
    # Do not overwrite a source the administrator has edited or disabled.
    if [ "$RET" = true ] && [ ! -e "$source" ] && [ ! -e /var/lib/silo/apt-source-configured ]; then
        install -d -m 755 /etc/apt/sources.list.d
        install -m 644 "$template" "$source"
    elif [ "$RET" != true ] && [ -f "$source" ] && cmp -s "$source" "$template"; then
        rm -f "$source"
    fi
    install -d -m 755 /var/lib/silo
    touch /var/lib/silo/apt-source-configured
fi
rm -f /var/lib/silo/package-update-in-progress
