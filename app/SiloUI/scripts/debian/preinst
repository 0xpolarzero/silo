#!/bin/sh
set -eu
# Block new Silo starts before checking existing processes. Never kill user VMs.
case "$1" in install|upgrade)
    install -d -m 755 /var/lib/silo
    touch /var/lib/silo/package-update-in-progress
    chmod 644 /var/lib/silo/package-update-in-progress
    for executable in /proc/[0-9]*/exe; do
        target=$(readlink "$executable" 2>/dev/null) || continue
        case "$target" in
            /usr/bin/silo-ui|'/usr/bin/silo-ui (deleted)'|/usr/lib/Silo/bin/msb|'/usr/lib/Silo/bin/msb (deleted)')
                rm -f /var/lib/silo/package-update-in-progress
                echo 'Quit Silo on this computer, then retry the update. Running local VMs must stop before Silo can be replaced.' >&2
                exit 1
                ;;
        esac
    done
    ;;
esac
