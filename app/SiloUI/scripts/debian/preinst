#!/bin/sh
set -eu
# Block new Silo starts before checking existing processes. Never kill user VMs.
case "$1" in install|upgrade)
    install -d -m 755 /var/lib/silo
    touch /var/lib/silo/package-update-in-progress
    chmod 644 /var/lib/silo/package-update-in-progress
    for executable in /proc/[0-9]*/exe; do
        target=$(readlink "$executable" 2>/dev/null) || continue
        case "$target" in
            /usr/bin/silo-ui|'/usr/bin/silo-ui (deleted)'|/usr/libexec/silo/tools/msb|'/usr/libexec/silo/tools/msb (deleted)')
                pid=${executable#/proc/}; pid=${pid%/exe}
                case "$target" in /usr/bin/silo-ui|'/usr/bin/silo-ui (deleted)')
                    arguments=$( { tr '\0' '\n' < "/proc/$pid/cmdline"; } 2>/dev/null ) || arguments=
                    # A process that has already exited cannot block the update.
                    [ -n "$arguments" ] || continue
                    # Remote-management relays (--remote-bridge from sshd, --remote-guest
                    # from an editor's SSH ProxyCommand) forward one request or stream and
                    # hold no VM or app state. The marker above refuses new relays.
                    case "$(printf '%s\n' "$arguments" | sed -n 2p)" in
                        --remote-bridge|--remote-guest) continue ;;
                    esac
                    # Only the authenticated updater may keep its inert UI alive.
                    # Other Silo instances and all running local runtimes still block.
                    if [ -x /usr/lib/silo/silo-system-update ] && /usr/lib/silo/silo-system-update --allows-running "$pid"; then
                        continue
                    fi
                    blocker="Silo (process $pid) is still running"
                    ;;
                *)
                    blocker="A local computer runtime (msb, process $pid) is still running"
                    ;;
                esac
                rm -f /var/lib/silo/package-update-in-progress
                echo "Quit Silo on this device, then retry the update. $blocker. Running local computers must stop before Silo can be replaced." >&2
                exit 1
                ;;
        esac
    done
    ;;
esac
