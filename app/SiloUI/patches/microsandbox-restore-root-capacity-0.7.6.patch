+#[cfg(feature = "local")]
+pub(crate) fn apply_snapshot_root_capacity(
+    config: &mut SandboxConfig,
+    virtual_size_bytes: Option<u64>,
+) -> MicrosandboxResult<()> {
+    let Some(virtual_size_bytes) = virtual_size_bytes else {
+        return Ok(());
+    };
+    const MIB_BYTES: u64 = 1024 * 1024;
+    if virtual_size_bytes == 0 {
+        return Err(MicrosandboxError::SnapshotIntegrity(
+            "snapshot root-disk capacity is zero".into(),
+        ));
+    }
+    // Declared sizes are whole MiB. A disk that is not an exact multiple (hand-built or
+    // foreign archives) is declared at the next whole MiB, never below its real size.
+    let size_mib = u32::try_from(virtual_size_bytes.div_ceil(MIB_BYTES)).map_err(|_| {
+        MicrosandboxError::SnapshotIntegrity("snapshot root-disk capacity exceeds its bound".into())
+    })?;
+    let RootfsSource::Oci(oci) = &mut config.spec.image else {
+        return Err(MicrosandboxError::SnapshotIntegrity(
+            "snapshot image did not resolve to an OCI rootfs".into(),
+        ));
+    };
+    match oci.root_disk.as_mut() {
+        Some(RootDisk::Managed { size_mib: size })
+        | Some(RootDisk::Flat { size_mib: size, .. }) => *size = Some(size_mib),
+        _ => {
+            return Err(MicrosandboxError::SnapshotIntegrity(
+                "snapshot root capacity does not match its root-disk layout".into(),
+            ));
+        }
+    }
+    Ok(())
+}
