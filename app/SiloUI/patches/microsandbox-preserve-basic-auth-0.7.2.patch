+    #[test]
+    fn legacy_secret_scopes_keep_independent_basic_auth_policy() {
+        for (headers, basic_auth, query_params) in [(false, true, true), (true, false, false)] {
+            let mut raw: Value = serde_json::from_str(LATEST).unwrap();
+            raw["network"]["secrets"]["secrets"] = json!([{
+                "env_var": "TEST_KEY",
+                "value": "synthetic-only",
+                "source": null,
+                "placeholder": "$TEST_KEY",
+                "allowed_hosts": [],
+                "injection": {
+                    "headers": headers,
+                    "basic_auth": basic_auth,
+                    "query_params": query_params,
+                    "body": false
+                },
+                "require_tls_identity": true
+            }]);
+            let decoded = decode(&raw.to_string()).unwrap();
+            let serialized = serde_json::to_value(decoded).unwrap();
+            let scopes = &serialized["network"]["secrets"]["secrets"][0]["substitution"];
+            assert_eq!(scopes["headers"], headers);
+            assert_eq!(scopes["basic_auth"], basic_auth);
+            assert_eq!(scopes["query"], query_params);
+            assert_eq!(scopes["body"], false);
+        }
+    }
