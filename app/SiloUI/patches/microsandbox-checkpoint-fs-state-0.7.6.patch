+/// Verify every device-state object under per-object limits and one aggregate byte budget.
+fn verify_device_states(root: &Path, devices: &[DeviceStateRef]) -> ImageResult<()> {
+    let mut total = 0u64;
+    for device in devices {
+        let max_state_bytes = if device.device_type == VIRTIO_FS_DEVICE_TYPE {
+            MAX_FS_DEVICE_STATE_BYTES
+        } else {
+            MAX_DEVICE_STATE_BYTES
+        };
+        let bytes = read_object_verified(root, &device.state, max_state_bytes)?;
+        total = total.saturating_add(bytes.len() as u64);
+        if total > MAX_TOTAL_DEVICE_STATE_BYTES {
+            return checkpoint_error(format!(
+                "checkpoint device state exceeds the aggregate {MAX_TOTAL_DEVICE_STATE_BYTES} byte budget"
+            ));
+        }
+    }
+    Ok(())
+}
