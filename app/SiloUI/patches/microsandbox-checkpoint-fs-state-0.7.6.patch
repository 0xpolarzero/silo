+/// Add one device payload to the retained total, refusing the checkpoint past the budget.
+fn charge_device_state(retained: &mut u64, len: usize, device_id: &str) -> Result<(), String> {
+    *retained = retained.saturating_add(len as u64);
+    if *retained > MAX_TOTAL_DEVICE_STATE_BYTES {
+        return Err(format!(
+            "checkpoint device state exceeds the aggregate {MAX_TOTAL_DEVICE_STATE_BYTES} byte budget at device {device_id}"
+        ));
+    }
+    Ok(())
+}
