diff --git a/packages/microsandbox-types/rust/lib/secret_values.rs b/packages/microsandbox-types/rust/lib/secret_values.rs
new file mode 100644
index 00000000..e846afbc
--- /dev/null
+++ b/packages/microsandbox-types/rust/lib/secret_values.rs
@@ -0,0 +1,128 @@
+//! Secret source values handed to this process on standard input.
+//!
+//! A launcher that must not expose secret values in the host environment (where
+//! processes of the same user can read them, and where a name such as
+//! `SSLKEYLOGFILE` would change host behaviour) sets `MSB_SECRET_VALUES_STDIN=1` and
+//! writes one JSON object of `{"SOURCE_NAME": "value"}` to standard input. The
+//! values are then authoritative for environment-kind secret sources: the host
+//! environment is never consulted for them, so a missing value fails closed.
+
+use std::{collections::HashMap, io::Read, sync::OnceLock};
+
+use zeroize::Zeroizing;
+use sha2::{Digest, Sha256};
+
+//--------------------------------------------------------------------------------------------------
+// Constants
+//--------------------------------------------------------------------------------------------------
+
+/// Environment flag that asks this process to read secret values from standard input.
+pub const STDIN_FLAG: &str = "MSB_SECRET_VALUES_STDIN";
+
+/// Largest accepted secret-value document, in bytes.
+const MAX_DOCUMENT_BYTES: u64 = 8 * 1024 * 1024;
+
+//--------------------------------------------------------------------------------------------------
+// Statics
+//--------------------------------------------------------------------------------------------------
+
+static PROVIDED: OnceLock<HashMap<String, Zeroizing<String>>> = OnceLock::new();
+
+//--------------------------------------------------------------------------------------------------
+// Functions
+//--------------------------------------------------------------------------------------------------
+
+/// Read the secret-value document from `input` when `requested`, and make it the
+/// only source of environment-kind secret values for this process.
+pub fn install_from(requested: bool, input: impl Read) -> Result<(), String> {
+    if !requested {
+        return Ok(());
+    }
+    let mut document = Zeroizing::new(Vec::new());
+    input
+        .take(MAX_DOCUMENT_BYTES + 1)
+        .read_to_end(&mut document)
+        .map_err(|_| "secret values could not be read from standard input".to_string())?;
+    if document.len() as u64 > MAX_DOCUMENT_BYTES {
+        return Err("secret values on standard input are too large".into());
+    }
+    let parsed: HashMap<String, String> = serde_json::from_slice(&document)
+        .map_err(|_| "secret values on standard input are not a JSON object of strings".to_string())?;
+    let values = parsed
+        .into_iter()
+        .map(|(name, value)| (name, Zeroizing::new(value)))
+        .collect();
+    PROVIDED
+        .set(values)
+        .map_err(|_| "secret values were already provided".to_string())
+}
+
+/// True when the launcher supplied secret values to this process.
+pub fn provided() -> bool {
+    PROVIDED.get().is_some()
+}
+
+/// Stable generated source name for a guest secret when stdin values were supplied.
+/// GitHub's reserved profile keeps its protocol name. The first 128 bits of SHA-256
+/// avoid shifting source references when other assignments are added or removed.
+pub fn source_for_guest(name: &str) -> String {
+    if !provided() || name == "SILO_GITHUB" {
+        return name.to_owned();
+    }
+    let digest = Sha256::digest(name.as_bytes());
+    let number = u128::from_be_bytes(digest[..16].try_into().expect("SHA-256 has 16 bytes"));
+    format!("SILO_SECRET_{number}")
+}
+
+/// The value of an environment-kind secret source named `var`: from the supplied
+/// values when the launcher supplied them (the host environment is then never
+/// read), otherwise from the host environment. `None` when it is not set.
+pub fn env_source_value(var: &str) -> Option<Zeroizing<String>> {
+    match PROVIDED.get() {
+        Some(values) => values.get(var).cloned(),
+        None => std::env::var(var).ok().map(Zeroizing::new),
+    }
+}
+
+//--------------------------------------------------------------------------------------------------
+// Tests
+//--------------------------------------------------------------------------------------------------
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn supplied_values_are_authoritative_and_bounded() {
+        // Nothing is read unless requested.
+        install_from(false, &b"not json"[..]).unwrap();
+        assert!(!provided());
+        assert_eq!(source_for_guest("API_KEY"), "API_KEY");
+        assert!(install_from(true, &b"[1]"[..]).is_err());
+        assert!(install_from(true, &b"{\"A\":1}"[..]).is_err());
+        assert!(!provided());
+        let oversized = vec![b' '; MAX_DOCUMENT_BYTES as usize + 1];
+        assert!(install_from(true, &oversized[..]).is_err());
+
+        // SAFETY: this test owns this variable name; no other code reads it.
+        unsafe { std::env::set_var("MSB_SECRET_VALUES_TEST_HOST_ONLY", "from-host") };
+        assert_eq!(
+            env_source_value("MSB_SECRET_VALUES_TEST_HOST_ONLY").as_deref().map(String::as_str),
+            Some("from-host")
+        );
+        install_from(true, &br#"{"SILO_GITHUB":"{\"version\":1}","SILO_SECRET_272068193077316117667065620025266693635":"value"}"#[..]).unwrap();
+        assert!(provided());
+        assert_eq!(source_for_guest("SILO_GITHUB"), "SILO_GITHUB");
+        assert_eq!(source_for_guest("API_KEY"), "SILO_SECRET_272068193077316117667065620025266693635");
+        assert_ne!(source_for_guest("API_KEY"), source_for_guest("OTHER"));
+        assert_eq!(env_source_value(&source_for_guest("API_KEY")).as_deref().map(String::as_str), Some("value"));
+        assert_eq!(
+            env_source_value("SILO_GITHUB").as_deref().map(String::as_str),
+            Some("{\"version\":1}")
+        );
+        assert!(env_source_value("API_KEY").is_none());
+        // Once supplied, the host environment is no longer a source.
+        assert!(env_source_value("MSB_SECRET_VALUES_TEST_HOST_ONLY").is_none());
+        assert!(install_from(true, &b"{}"[..]).is_err());
+    }
+}
