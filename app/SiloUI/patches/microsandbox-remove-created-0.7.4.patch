+
+/// Whether a persisted local sandbox in `status` may be removed once its lifecycle locks are held.
+///
+/// `Created` is a sandbox that was prepared and never started. It has no run record, runtime
+/// process or socket to reconcile, and `SandboxHandle::remove` and `destroy` already treat it
+/// as removable, so this check must not be stricter than they are.
+#[cfg(feature = "local")]
+fn sandbox_status_allows_removal(status: SandboxStatus) -> bool {
+    matches!(
+        status,
+        SandboxStatus::Created | SandboxStatus::Stopped | SandboxStatus::Crashed
+    )
 }
 
