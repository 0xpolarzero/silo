+    #[tokio::test]
+    async fn persisted_removal_removes_a_sandbox_that_never_started() {
+        use crate::db::entity::sandbox_label as label_entity;
+
+        let temp = tempdir().unwrap();
+        let backend = LocalBackend::builder()
+            .config_path(temp.path().join("home").join("config.json"))
+            .managed_config_path(temp.path().join("home").join("managed.json"))
+            .home(temp.path().join("home"))
+            .build()
+            .await
+            .unwrap();
+        let pools = backend.db().await.unwrap();
+
+        // A `Created` sandbox was prepared and never started. It owns the same private directory
+        // and catalog rows as a stopped one, and has no runtime to prove gone, so it must be
+        // removed the same way.
+        for (name, status) in [
+            ("never-started", SandboxStatus::Created),
+            ("stopped", SandboxStatus::Stopped),
+            ("crashed", SandboxStatus::Crashed),
+        ] {
+            let current = super::sandbox_entity::ActiveModel {
+                name: Set(name.to_string()),
+                config: Set("{}".to_string()),
+                status: Set(status),
+                ephemeral: Set(false),
+                ..Default::default()
+            }
+            .insert(pools.write())
+            .await
+            .unwrap();
+            label_entity::ActiveModel {
+                sandbox_id: Set(current.id),
+                key: Set("owner".to_string()),
+                value: Set("test".to_string()),
+            }
+            .insert(pools.write())
+            .await
+            .unwrap();
+            let sandbox_dir = backend.sandboxes_dir().join(name);
+            std::fs::create_dir_all(sandbox_dir.join("runtime")).unwrap();
+            std::fs::write(sandbox_dir.join("runtime").join("marker"), b"prepared").unwrap();
+
+            remove_local_persisted_sandbox(&backend, name, current.id)
+                .await
+                .unwrap();
+
+            assert!(!sandbox_dir.exists(), "{status:?} directory");
+            assert!(
+                super::sandbox_entity::Entity::find_by_id(current.id)
+                    .one(pools.read())
+                    .await
+                    .unwrap()
+                    .is_none(),
+                "{status:?} record"
+            );
+            assert!(
+                label_entity::Entity::find()
+                    .filter(label_entity::Column::SandboxId.eq(current.id))
+                    .all(pools.read())
+                    .await
+                    .unwrap()
+                    .is_empty(),
+                "{status:?} labels"
+            );
+        }
     }
+
+    #[tokio::test]
+    async fn persisted_removal_still_refuses_a_sandbox_that_may_own_a_runtime() {
+        let temp = tempdir().unwrap();
+        let backend = LocalBackend::builder()
+            .config_path(temp.path().join("home").join("config.json"))
+            .managed_config_path(temp.path().join("home").join("managed.json"))
+            .home(temp.path().join("home"))
+            .build()
+            .await
+            .unwrap();
+        let pools = backend.db().await.unwrap();
+
+        for (name, status) in [
+            ("starting", SandboxStatus::Starting),
+            ("running", SandboxStatus::Running),
+            ("draining", SandboxStatus::Draining),
+            ("paused", SandboxStatus::Paused),
+        ] {
+            let current = super::sandbox_entity::ActiveModel {
+                name: Set(name.to_string()),
+                config: Set("{}".to_string()),
+                status: Set(status),
+                ephemeral: Set(false),
+                ..Default::default()
+            }
+            .insert(pools.write())
+            .await
+            .unwrap();
+            let sandbox_dir = backend.sandboxes_dir().join(name);
+            std::fs::create_dir_all(&sandbox_dir).unwrap();
+            std::fs::write(sandbox_dir.join("marker"), b"live").unwrap();
+
+            let error = remove_local_persisted_sandbox(&backend, name, current.id)
+                .await
+                .unwrap_err();
+
+            assert!(
+                matches!(error, crate::MicrosandboxError::SandboxStillRunning(_)),
+                "{status:?}: {error}"
+            );
+            assert!(sandbox_dir.join("marker").exists(), "{status:?} directory");
+            assert!(
+                super::sandbox_entity::Entity::find_by_id(current.id)
+                    .one(pools.read())
+                    .await
+                    .unwrap()
+                    .is_some(),
+                "{status:?} record"
+            );
+        }
+    }
