+    /// Identity of the active local runtime generation, if it still matches this handle.
+    pub async fn runtime_instance_id(&self) -> MicrosandboxResult<Option<String>> {
+        let Some(local) = self.local() else {
+            return Ok(None);
+        };
+        if local.status != SandboxStatus::Running || local.pid.is_none() {
+            return Ok(None);
+        }
+        let Some(backend) = self.backend.as_local() else {
+            return Ok(None);
+        };
+        let pools = backend.db().await?;
+        let run = crate::backend::LocalBackend::load_active_run(pools.read(), local.db_id).await?;
+        Ok(run
+            .filter(|run| run.pid == local.pid)
+            .and_then(|run| run.started_at.map(|started| format!("{}:{}", run.id, started))))
+    }
