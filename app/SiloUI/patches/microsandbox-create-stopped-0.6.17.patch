 async fn run_serve(args: SshServeArgs) -> anyhow::Result<()> {
+    if args.exit_on_stdin_close {
+        // A dedicated OS thread avoids Tokio stdin's blocking task, which can
+        // prevent runtime shutdown while the parent still holds its pipe open.
+        let closed = owner_stdin_closed(std::io::stdin());
