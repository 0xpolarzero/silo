+async fn install_local_vmdk(target: &Path, extents: &[PathBuf]) -> MicrosandboxResult<()> {
+    let parent = target
+        .parent()
+        .ok_or_else(|| MicrosandboxError::Custom("VMDK cache path has no parent".into()))?;
+    tokio::fs::create_dir_all(parent).await?;
+    let staged = tempfile::NamedTempFile::new_in(parent)?;
+    let refs: Vec<&Path> = extents.iter().map(PathBuf::as_path).collect();
+    microsandbox_image::write_vmdk_descriptor(staged.path(), &refs)?;
+    staged.as_file().sync_all()?;
+    if tokio::fs::symlink_metadata(target).await.is_ok() {
+        ensure_cache_target_compatible(staged.path(), target).await?;
+        return Ok(());
+    }
+    match staged.persist_noclobber(target) {
+        Ok(_) => {}
+        Err(error) if error.error.kind() == std::io::ErrorKind::AlreadyExists => {
+            ensure_cache_target_compatible(error.file.path(), target).await?;
+        }
+        Err(error) => return Err(error.error.into()),
+    }
+    Ok(())
