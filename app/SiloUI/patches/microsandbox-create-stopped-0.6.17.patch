+/// Only phase names and counts cross this boundary; image references and paths stay private.
+fn progress_json(event: &microsandbox_image::PullProgress) -> serde_json::Value {
+    use microsandbox_image::PullProgress;
+    use serde_json::json;
+    match event {
+        PullProgress::Resolving { .. } => {
+            json!({"type": "silo-progress", "phase": "image-resolving"})
+        }
+        PullProgress::Resolved {
+            layer_count,
+            total_download_bytes,
+            ..
+        } => {
+            json!({"type": "silo-progress", "phase": "image-resolved", "layerCount": layer_count, "totalBytes": total_download_bytes})
+        }
+        PullProgress::LayerDownloadProgress {
+            layer_index,
+            downloaded_bytes,
+            total_bytes,
+            ..
+        } => {
+            json!({"type": "silo-progress", "phase": "image-download", "layerIndex": layer_index, "downloadedBytes": downloaded_bytes, "totalBytes": total_bytes})
+        }
+        PullProgress::LayerDownloadComplete {
+            layer_index,
+            downloaded_bytes,
+            ..
+        } => {
+            json!({"type": "silo-progress", "phase": "image-downloaded", "layerIndex": layer_index, "downloadedBytes": downloaded_bytes})
+        }
+        PullProgress::LayerDownloadVerifying { layer_index, .. } => {
+            json!({"type": "silo-progress", "phase": "image-verifying", "layerIndex": layer_index})
+        }
+        PullProgress::LayerMaterializeStarted { layer_index, .. }
+        | PullProgress::LayerMaterializeWriting { layer_index }
+        | PullProgress::LayerMaterializeComplete { layer_index, .. } => {
+            json!({"type": "silo-progress", "phase": "image-preparing", "layerIndex": layer_index})
+        }
+        PullProgress::LayerMaterializeProgress {
+            layer_index,
+            bytes_read,
+            total_bytes,
+        } => {
+            json!({"type": "silo-progress", "phase": "image-preparing", "layerIndex": layer_index, "preparedBytes": bytes_read, "totalBytes": total_bytes})
+        }
+        PullProgress::StitchMergingTrees { .. }
+        | PullProgress::StitchWritingFsmeta
+        | PullProgress::StitchWritingVmdk
+        | PullProgress::StitchComplete => {
+            json!({"type": "silo-progress", "phase": "image-preparing"})
+        }
+        PullProgress::Complete { .. } => json!({"type": "silo-progress", "phase": "image-ready"}),
+    }
+}
