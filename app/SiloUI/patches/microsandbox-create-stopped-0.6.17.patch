+#[cfg(test)]
+mod progress_tests {
+    use super::*;
+    use microsandbox_image::PullProgress;
+
+    #[test]
+    fn reports_actual_bytes_without_image_credentials() {
+        let event = PullProgress::LayerDownloadProgress {
+            layer_index: 2,
+            digest: "private-digest".into(),
+            downloaded_bytes: 123,
+            total_bytes: Some(456),
+        };
+        assert_eq!(
+            progress_json(&event),
+            serde_json::json!({
+                "type": "silo-progress", "phase": "image-download", "layerIndex": 2,
+                "downloadedBytes": 123, "totalBytes": 456,
+            })
+        );
+        let event = PullProgress::Resolving {
+            reference: "https://user:secret@example.com/image".into(),
+        };
+        assert_eq!(
+            progress_json(&event),
+            serde_json::json!({"type": "silo-progress", "phase": "image-resolving"})
+        );
+    }
+
+    #[test]
+    fn throttles_bytes_without_dropping_completion() {
+        let event = PullProgress::LayerDownloadProgress {
+            layer_index: 0,
+            digest: "unused".into(),
+            downloaded_bytes: 1,
+            total_bytes: Some(2),
+        };
+        let mut last = None;
+        assert!(should_emit_progress(&event, &mut last));
+        assert!(!should_emit_progress(&event, &mut last));
+        let complete = PullProgress::LayerDownloadComplete {
+            layer_index: 0,
+            digest: "unused".into(),
+            downloaded_bytes: 2,
+        };
+        assert!(should_emit_progress(&complete, &mut last));
+        assert_eq!(progress_json(&complete)["downloadedBytes"], 2);
+    }
+
+    #[test]
+    fn unknown_download_size_stays_unknown() {
+        let event = PullProgress::LayerDownloadProgress {
+            layer_index: 0,
+            digest: "unused".into(),
+            downloaded_bytes: 123,
+            total_bytes: None,
+        };
+        assert!(progress_json(&event)["totalBytes"].is_null());
+    }
+}
+
+// Bound diagnostic output independently of image size. Phase and completion events are never throttled.
+fn should_emit_progress(
+    event: &microsandbox_image::PullProgress,
+    last: &mut Option<std::time::Instant>,
+) -> bool {
+    use microsandbox_image::PullProgress;
+    if !matches!(
+        event,
+        PullProgress::LayerDownloadProgress { .. } | PullProgress::LayerMaterializeProgress { .. }
+    ) {
+        return true;
+    }
+    let now = std::time::Instant::now();
+    if last.is_some_and(|previous| now.duration_since(previous) < std::time::Duration::from_secs(1))
+    {
+        return false;
+    }
+    *last = Some(now);
+    true
+}
