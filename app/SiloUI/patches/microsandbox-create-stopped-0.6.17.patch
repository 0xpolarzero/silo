+                ControlRequest::PortsList => ports.list(),
+                ControlRequest::PortAdd { guest_port, host_port } => ports.add(guest_port, host_port),
+                ControlRequest::PortRemove { guest_port } => ports.remove(guest_port),
+                _ => unreachable!(),
+            });
+        match result {
+            Ok(ports) => ControlResponse { ok: true, ports: Some(ports), ..Default::default() },
+            Err(error) => ControlResponse { error: Some(error), ..Default::default() },
+        }
+    }
+    #[cfg(not(feature = "net"))]
+    {
+        let _ = (context, request);
