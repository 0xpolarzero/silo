+/// Cloneable host-owned control handle. The poll thread owns all listeners.
+#[derive(Clone)]
+pub struct PortControlHandle {
+    tx: sync_mpsc::Sender<PortCommand>,
+    shared: Arc<SharedState>,
+}
+
+impl PortControlHandle {
+    pub fn channel(shared: Arc<SharedState>) -> (Self, sync_mpsc::Receiver<PortCommand>) {
+        let (tx, rx) = sync_mpsc::channel();
+        (Self { tx, shared }, rx)
+    }
+
+    pub fn list(&self) -> Result<Vec<PublishedPort>, String> {
+        let (reply, rx) = sync_mpsc::sync_channel(1);
+        self.request(PortCommand::List(reply), rx)
+    }
+
+    pub fn add(&self, guest_port: u16, host_port: u16) -> Result<Vec<PublishedPort>, String> {
+        let (reply, rx) = sync_mpsc::sync_channel(1);
+        self.request(
+            PortCommand::Add {
+                guest_port,
+                host_port,
+                reply,
+            },
+            rx,
+        )
+    }
+
+    pub fn probe(&self, guest_port: u16) -> Result<bool, String> {
+        if guest_port == 0 {
+            return Err("guest port must be nonzero".into());
+        }
+        let (reply, rx) = sync_mpsc::sync_channel(1);
+        self.tx
+            .send(PortCommand::Probe { guest_port, reply })
+            .map_err(|_| "network poll thread stopped".to_string())?;
+        self.shared.proxy_wake.wake();
+        rx.recv_timeout(Duration::from_millis(800))
+            .map_err(|_| "network port probe timed out".to_string())?
+    }
+
+    pub fn remove(&self, guest_port: u16) -> Result<Vec<PublishedPort>, String> {
+        let (reply, rx) = sync_mpsc::sync_channel(1);
+        self.request(PortCommand::Remove { guest_port, reply }, rx)
+    }
+
+    fn request(
+        &self,
+        command: PortCommand,
+        rx: sync_mpsc::Receiver<Result<Vec<PublishedPort>, String>>,
+    ) -> Result<Vec<PublishedPort>, String> {
+        self.tx
+            .send(command)
+            .map_err(|_| "network poll thread stopped".to_string())?;
+        self.shared.proxy_wake.wake();
+        rx.recv_timeout(Duration::from_secs(2))
+            .map_err(|_| "network port control timed out".to_string())?
+    }
 }
 
