{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview",
  "description": "The main window owns shared settings and onboarding drafts, and can drag, resize, minimize, and close itself.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "allow-read-settings",
    "allow-initialize-settings",
    "allow-update-settings",
    "allow-update-onboarding-draft",
    "allow-import-legacy-theme",
    "allow-flush-settings",
    "allow-begin-settings-flush",
    "allow-complete-settings-flush",
    "allow-read-system-integrations",
    "allow-set-login-item",
    "allow-request-notification-authorization",
    "allow-open-integration-settings",
    "allow-show-integration-error",
    "allow-list-applications",
    "allow-choose-application",
    "allow-read-dependencies",
    "allow-read-backup-state",
    "allow-choose-backup-destination",
    "allow-choose-backup-archive",
    "allow-inspect-backup-archive",
    "allow-start-backup",
    "allow-start-restore",
    "allow-cancel-backup-operation",
    "allow-dismiss-backup-operation",
    "allow-read-application-state", "allow-push-repository",
    "allow-read-machine-configuration",
    "allow-read-secrets-state",
    "allow-save-secret",
    "allow-remove-secret",
    "allow-retry-secret",
    "allow-read-github-state",
    "allow-connect-github",
    "allow-disconnect-github",
    "allow-set-github-access-enabled",
    "allow-save-github-configuration",
    "allow-retry-github-configuration",
    "allow-refresh-github-repositories",

    "allow-workspace-action",
    "allow-retry-workspace-start",
    "allow-configure-workspace-identities",
    "allow-verify-workspace-identities",
    "allow-read-setup-activity",
    "allow-save-machine-configuration"
  ]
}
