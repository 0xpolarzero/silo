{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "status",
  "description": "The status panel can read shared preferences, resize and dismiss itself, open the main window, update the tray, and quit Silo. It cannot change settings or read onboarding drafts.",
  "windows": ["status"],
  "permissions": ["allow-open-main", "allow-hide-status", "allow-resize-status", "allow-quit-app", "allow-update-tray", "allow-read-settings", "allow-list-applications", "allow-read-application-state", "allow-read-machine-configuration", "allow-push-repository", "allow-read-backup-state", "allow-workspace-action", "allow-retry-workspace-start"]
}
