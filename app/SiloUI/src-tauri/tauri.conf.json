{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Silo Preview",
  "version": "../package.json",
  "identifier": "org.silo.preview",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run runtime:prepare && npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Silo Preview",
        "width": 1160,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 24 },
        "visible": false,
        "label": "main"
      },
      {
        "label": "status",
        "title": "Silo",
        "url": "index.html?native-status",
        "width": 380,
        "height": 320,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "shadow": true
      }
    ],
    "security": {
      "capabilities": [
        "preview", "status", "fixture-events"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/msb"],
    "resources": {
      "runtime/microsandbox/manifest.json": "microsandbox/manifest.json",
      "runtime/microsandbox/licenses/": "microsandbox/licenses/",
      "../THIRD-PARTY-NOTICES.md": "microsandbox/THIRD-PARTY-NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
