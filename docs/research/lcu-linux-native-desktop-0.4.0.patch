diff --git a/tests/test_native_desktop_registration.py b/tests/test_native_desktop_registration.py
new file mode 100644
--- /dev/null
+++ b/tests/test_native_desktop_registration.py
@@ -0,0 +1,72 @@
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from lcu.setup import MCP_REGISTER, native_desktop_server_env
+
+
+class NativeDesktopRegistrationTests(unittest.TestCase):
+    def test_setup_opt_in_is_linux_only_and_absent_by_default(self):
+        self.assertEqual(native_desktop_server_env({}), {})
+        self.assertEqual(native_desktop_server_env({'LCU_LINUX_NATIVE_DESKTOP': '0'}), {})
+        with mock.patch('lcu.setup.sys.platform', 'linux'):
+            self.assertEqual(native_desktop_server_env({'LCU_LINUX_NATIVE_DESKTOP': '1'}),
+                             {'LCU_LINUX_NATIVE_DESKTOP': '1'})
+        with mock.patch('lcu.setup.sys.platform', 'darwin'):
+            with self.assertRaisesRegex(ValueError, 'supported only on Linux'):
+                native_desktop_server_env({'LCU_LINUX_NATIVE_DESKTOP': '1'})
+        with self.assertRaisesRegex(ValueError, 'must be 1'):
+            native_desktop_server_env({'LCU_LINUX_NATIVE_DESKTOP': '/tmp/custom'})
+
+    @unittest.skipUnless(shutil.which('node'), 'Node.js is required to exercise the existing MCP writer')
+    def test_mcp_writer_persists_only_opted_in_env_and_preserves_adapter_argv(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            cli = root / 'bin/codex'
+            cli.parent.mkdir()
+            cli.touch()
+            (cli.parent / 'lib.js').write_text(
+                'import {writeFileSync} from "node:fs";\n'
+                'export const agents = {codex: {transformConfig: () => ({})}};\n'
+                'export function upsertServer(agent, name, server, options) {\n'
+                ' writeFileSync(process.env.LCU_TEST_RECORD, JSON.stringify({agent,name,server,options}));\n'
+                ' return {success:true};\n'
+                '}\n'
+            )
+            record = root / 'record.json'
+            node = shutil.which('node')
+            command = [
+                '/opt/lcu/current/agent-tools/node/bin/node',
+                '/opt/lcu/current/adapters/codex.mjs',
+                '/opt/lcu/current/bin/lcu',
+            ]
+
+            def register(server_env):
+                env = dict(os.environ, LCU_TEST_RECORD=str(record))
+                subprocess.run(
+                    [node, '--input-type=module', '-e', MCP_REGISTER,
+                     str(cli), 'codex', 'user', json.dumps(command), json.dumps({}), json.dumps(server_env)],
+                    env=env, check=True, timeout=10, capture_output=True, text=True,
+                )
+                return json.loads(record.read_text())
+
+            default = register({})
+            self.assertEqual(default['server']['command'], command[0])
+            self.assertEqual(default['server']['args'], command[1:])
+            self.assertNotIn('env', default['server'])
+
+            opted_in = register({'LCU_LINUX_NATIVE_DESKTOP': '1'})
+            self.assertEqual(opted_in['server']['command'], command[0])
+            self.assertEqual(opted_in['server']['args'], command[1:])
+            self.assertEqual(opted_in['server']['env'], {'LCU_LINUX_NATIVE_DESKTOP': '1'})
+
+
+if __name__ == '__main__':
+    unittest.main()
